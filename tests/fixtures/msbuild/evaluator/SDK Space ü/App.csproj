<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0</TargetFrameworks>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>Collision</AssemblyName>
    <LangVersion>12.0</LangVersion>
    <DefineConstants>COMMON</DefineConstants>
    <DefineConstants Condition="'$(TargetFramework)' == 'net8.0'">COMMON;EIGHT</DefineConstants>
    <DefineConstants Condition="'$(TargetFramework)' == 'net9.0'">COMMON;NINE</DefineConstants>
  </PropertyGroup>
  <Import Project="../shared/Imported.props" />
  <ItemGroup>
    <Compile Include="Local.cs" />
    <Compile Include="Glob/**/*.cs" Exclude="Glob/Excluded.cs" />
    <Compile Remove="Glob/Removed.cs" />
    <Compile Include="Conditioned.cs" Condition="'$(Configuration)' == 'Qualification'" />
    <Reference Include="Hand.Reference"><HintPath>../shared/Hand.Reference.dll</HintPath><Private>False</Private></Reference>
    <ProjectReference Include="../Twin/Twin.csproj"><ReferenceOutputAssembly>False</ReferenceOutputAssembly><Name>Twin declaration</Name></ProjectReference>
  </ItemGroup>
  <ItemGroup><Compile Include="Eight.cs" Condition="'$(TargetFramework)' == 'net8.0'" /></ItemGroup>
</Project>
